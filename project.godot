; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="The Wall"
run/main_scene="res://scenes/levelTest/lvl_test.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

UiDebug="*res://ui/debug/ui_debug.tscn"
PlayerHud="*res://ui/playerUI/playerHUD.tscn"
GameManager="*res://managers/Game Manager/game_manager.tscn"
MusicManager="*res://managers/Music Manager/music_manager.tscn"
Dialogic="*uid://ds2q0uclmolvu"

[dialogic]

directories/dch_directory={
"malloc": "res://dialogue/Malloc/malloc.dch",
"the_wall": "res://dialogue/The Wall/the_wall.dch",
"tracer": "res://dialogue/Tracer/tracer.dch",
"ux": "res://dialogue/UX/ux.dch",
"varia": "res://dialogue/Varia/varia.dch"
}
directories/dtl_directory={
"TW_first_greet_1": "res://dialogue/The Wall/TW_first_greet_1.dtl",
"TW_first_greet_2": "res://dialogue/The Wall/TW_first_greet_2.dtl",
"test": "res://dialogue/test.dtl"
}
layout/style_directory={
"": "res://dialogue/The Wall/the_wall_dialogue_style.tres",
"malloc_dialogue_style": "res://dialogue/Malloc/malloc_dialogue_style.tres",
"the_wall_dialogue_style": "res://dialogue/The Wall/the_wall_dialogue_style.tres",
"tracer_dialogue_style": "res://dialogue/Tracer/tracer_dialogue_style.tres",
"ux_dialogue_style": "res://dialogue/UX/ux_dialogue_style.tres",
"varia_dialogue_style": "res://dialogue/Varia/varia_dialogue_style.tres"
}
layout/style_list=["res://dialogue/The Wall/the_wall_dialogue_style.tres", "res://dialogue/Varia/varia_dialogue_style.tres", "res://dialogue/Malloc/malloc_dialogue_style.tres", "res://dialogue/Tracer/tracer_dialogue_style.tres", "res://dialogue/UX/ux_dialogue_style.tres"]
layout/default_style="res://dialogue/The Wall/the_wall_dialogue_style.tres"
variables={
"answered": false,
"nameChange": false,
"playerName": "Player"
}
extensions_folder="res://addons/dialogic_additions"
text/letter_speed=0.01
text/initial_text_reveal_skippable=true
text/text_reveal_skip_delay=0.1
text/advance_delay=0.1
text/autoadvance_per_character_delay=0.1
text/autoadvance_ignored_characters_enabled=true
animations/join_default_length=0.5
animations/join_default_wait=true
animations/leave_default_length=0.5
animations/leave_default_wait=true
animations/cross_fade_default_length=0.5
choices/autofocus_first=true
choices/delay=0.2
choices/reveal_delay=0
choices/reveal_by_input=false
save/autosave_delay=60.0
save/encryption_on_exports_only=true
audio/type_sound_bus="SFX"
text/autopauses={}
audio/channel_defaults={
"": {
"audio_bus": "",
"fade_length": 0.0,
"loop": false,
"volume": 0.0
},
"music": {
"audio_bus": "",
"fade_length": 0.0,
"loop": true,
"volume": 0.0
}
}

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/mode=4
window/size/resizable=false
window/size/window_width_override=1280
window/size/window_height_override=720
window/subwindows/embed_subwindows=false
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"
window/per_pixel_transparency/allowed=true
mouse_cursor/custom_image="uid://btehqqni61teh"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg", "res://addons/native_dialogs/plugin.cfg")

[global_group]

Player="The Player Character"
Enemy="Entity that DEALS DAMAGE "
Camera=""

[gui]

theme/custom_font="uid://ddqixrbdw5jbr"

